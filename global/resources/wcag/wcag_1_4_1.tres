[ext_resource type="Script" uid="uid://mgn4yar0d3vn" path="res://global/resources/wcag_data.gd" id="1_do5y7"]

[resource]
script = ExtResource("1_do5y7")
id = "1.4.1"
title = "Use of Color"
short_description = "This criterion states that color must not be the only way to convey information, actions, or status changes."
long_description = "[b][u]OBJECTIVE[/u][/b]
The WCAG 2.1 success criterion 1.4.1 - Use of Color ensures that users can understand content even if they cannot perceive colors correctly.

[b][u]TECHNICAL REQUIREMENTS[/u][/b]
Color alone cannot be used to:[indent]
[b]•[/b] Communicate information or indicate actions.
[b]•[/b] Show errors or required fields.
[b]•[/b] Distinguish interface elements.
[/indent]
[b][u]TIP[/u][/b]
Never rely on a change of color as the only way to signal information. Provide redundant visual cues such as icons, explicit text labels, patterns, or underlines."
metadata/_custom_type_script = "uid://mgn4yar0d3vn"
