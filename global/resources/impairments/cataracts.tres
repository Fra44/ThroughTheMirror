[resource]
script = ExtResource("1_7niso")
name = "Cataracts"
icon = ExtResource("1_bk1tu")
short_info = "CONTRAST RATIO 1.17:1"
manual_text = "Cataract is a condition in which the eye’s lens becomes cloudy, reducing vision quality and potentially leading to blindness. It is most commonly associated with aging, but it can also occur in children, after eye injuries, or due to diseases such as glaucoma and diabetes.

It is one of the leading causes of blindness worldwide, particularly in regions with limited access to eye care, even though cataracts can usually be treated through surgery.

Risk factors include steroid use, radiation exposure, smoking, and ultraviolet light. While there is no guaranteed prevention, reducing smoking and UV exposure may help delay its development.

The World Health Organization supports countries in improving eye care systems to reduce the global impact of cataracts."
related_wcag = ExtResource("1_f072e")
metadata/_custom_type_script = "uid://dry85ilgnq64e"
